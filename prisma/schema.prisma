datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  KITCHEN
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  PREPARED
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  CASH
}

enum NotificationType {
  NEW_ORDER
  PAYMENT
  CALL_WAITER
  REQUEST_BILL
  KITCHEN_READY
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum FoodType {
  VEG
  NON_VEG
  VEGAN
}

model AdminUser {
  id        String   @id // Matches Supabase Auth User ID (UUID)
  email     String   @unique
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id                      String  @id @default("singleton")
  restaurantName          String  @default("My Restaurant")
  logo                    String?
  banner                  String?
  address                 String?
  phone                   String?
  email                   String?
  primaryColor            String  @default("#E11D48")
  currency                String  @default("INR")
  timezone                String  @default("Asia/Kolkata")
  gstNumber               String?
  gstPercentage           Decimal  @default(5.0) @db.Decimal(5,2)
  serviceChargePercentage Decimal  @default(0.0) @db.Decimal(5,2)
  openingHours            Json?
  socialLinks             Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Table {
  id        String      @id @default(uuid())
  number    String      @unique
  qrCodeUrl String?
  status    TableStatus @default(AVAILABLE)
  orders    Order[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  image       String?
  sortOrder   Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryTree")
  menuItems   MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([name, parentId])
}

model MenuItem {
  id              String      @id @default(uuid())
  name            String
  description     String?
  price           Decimal  @db.Decimal(10,2)
  discountPrice   Decimal? @db.Decimal(10,2)
  foodType        FoodType    @default(VEG)
  spicyLevel      Int         @default(0)
  preparationTime Int         @default(15)
  images          String[]
  isAvailable     Boolean     @default(true)
  isChefSpecial   Boolean     @default(false)
  isBestSeller    Boolean     @default(false)
  ingredients     String[]
  allergens       String[]
  nutrition       Json?
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants        Variant[]
  addons          Addon[]
  orderItems      OrderItem[]
  reviews         Review[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Variant {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal  @db.Decimal(10,2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Addon {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal  @db.Decimal(10,2)
  isVeg      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id                  String        @id @default(uuid())
  tableId             String
  table               Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  customerName        String
  customerPhone       String
  status              OrderStatus   @default(PLACED)
  paymentStatus       PaymentStatus @default(PENDING)
  paymentMethod       PaymentMethod @default(CASH)
  subtotal            Decimal  @db.Decimal(10,2)
  discountAmount      Decimal  @default(0.0) @db.Decimal(10,2)
  gstAmount           Decimal  @default(0.0) @db.Decimal(10,2)
  serviceChargeAmount Decimal  @default(0.0) @db.Decimal(10,2)
  totalAmount         Decimal  @db.Decimal(10,2)
  offerCode           String?
  notes               String?
  orderItems          OrderItem[]
  payments            Payment[]
  reviews             Review[]
  invoices            Invoice[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  quantity       Int
  price          Decimal  @db.Decimal(10,2)
  notes          String?
  customizations Json?
  createdAt      DateTime @default(now())
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10,2)
  method        PaymentMethod
  transactionId String?
  paymentId     String?
  signature     String?
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Offer {
  id             String       @id @default(uuid())
  code           String       @unique
  title          String?
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Decimal      @db.Decimal(10,2)
  minOrderAmount Decimal      @default(0.0) @db.Decimal(10,2)
  expiryDate     DateTime
  usageLimit     Int?
  usageCount     Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Review {
  id           String    @id @default(uuid())
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  menuItemId   String?
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  customerName String
  rating       Int
  comment      String?
  images       String[]
  adminReply   String?
  createdAt    DateTime  @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model Invoice {
  id             String   @id @default(uuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber  String   @unique
  pdfUrl         String?
  amount         Decimal  @db.Decimal(10,2)
  taxAmount      Decimal  @db.Decimal(10,2)
  discountAmount Decimal  @db.Decimal(10,2)
  createdAt      DateTime @default(now())
}
