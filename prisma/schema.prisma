datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  RESTAURANT_OWNER
  MANAGER
  CASHIER
  SERVICE_STAFF
  CHEF_KITCHEN_STAFF
  INVENTORY_MANAGER
  PURCHASE_MANAGER
  ACCOUNTANT
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  PREPARED
  READY
  SERVED
  COMPLETED
  COLLECTED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  CASH
  UPI
  CARD
}

enum NotificationType {
  NEW_ORDER
  PAYMENT
  CALL_WAITER
  REQUEST_BILL
  KITCHEN_READY
  LOW_STOCK
  PURCHASE_APPROVAL
  PURCHASE_RECEIVED
  RESERVATION
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum FoodType {
  VEG
  NON_VEG
  VEGAN
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
  COMPLETED
}

enum StockMovementType {
  PURCHASE
  ADJUSTMENT
  WASTAGE
  ORDER_CONSUMPTION
  REVERSAL
}

enum PurchaseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  WATER
  SALARIES
  MAINTENANCE
  MARKETING
  TRANSPORTATION
  SUPPLIES
  OTHER
}

model AdminUser {
  id        String   @id // Matches Supabase Auth User ID (UUID)
  email     String   @unique
  name      String?
  role      Role     @default(RESTAURANT_OWNER)
  isActive  Boolean  @default(true)
  assignedOrders Order[] @relation("ServiceStaffAssignment")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id                      String  @id @default("singleton")
  restaurantName          String  @default("My Restaurant")
  logo                    String?
  banner                  String?
  address                 String?
  phone                   String?
  email                   String?
  primaryColor            String  @default("#E11D48")
  currency                String  @default("INR")
  timezone                String  @default("Asia/Kolkata")
  gstNumber               String?
  gstPercentage           Decimal  @default(5.0) @db.Decimal(5,2)
  serviceChargePercentage Decimal  @default(0.0) @db.Decimal(5,2)
  openingHours            Json?
  socialLinks             Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Table {
  id        String      @id @default(uuid())
  number    String      @unique
  qrCodeUrl String?
  status    TableStatus @default(AVAILABLE)
  orders    Order[]
  reservations Reservation[]
  createdAt DateTime    @default(now())
  updatedAt DateTime   @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  image       String?
  sortOrder   Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  menuItems   MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([name, parentId])
}

model MenuItem {
  id              String      @id @default(uuid())
  name            String
  description     String?
  price           Decimal  @db.Decimal(10,2)
  discountPrice   Decimal? @db.Decimal(10,2)
  foodType        FoodType    @default(VEG)
  spicyLevel      Int         @default(0)
  preparationTime Int         @default(15)
  images          String[]
  isAvailable     Boolean     @default(true)
  isChefSpecial   Boolean     @default(false)
  isBestSeller    Boolean     @default(false)
  ingredients     String[]
  allergens       String[]
  nutrition       Json?
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants        Variant[]
  addons          Addon[]
  recipeItems     RecipeIngredient[]
  orderItems      OrderItem[]
  reviews         Review[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Variant {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal  @db.Decimal(10,2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Addon {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal  @db.Decimal(10,2)
  isVeg      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id                  String        @id @default(uuid())
  orderNumber         String?       @unique
  orderType           OrderType     @default(DINE_IN)
  tableId             String?
  table               Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  assignedServiceStaffId String?
  assignedServiceStaff AdminUser?   @relation("ServiceStaffAssignment", fields: [assignedServiceStaffId], references: [id], onDelete: SetNull)
  customerName        String
  customerPhone       String
  status              OrderStatus   @default(PLACED)
  paymentStatus       PaymentStatus @default(PENDING)
  paymentMethod       PaymentMethod @default(CASH)
  subtotal            Decimal  @db.Decimal(10,2)
  discountAmount      Decimal  @default(0.0) @db.Decimal(10,2)
  gstAmount           Decimal  @default(0.0) @db.Decimal(10,2)
  serviceChargeAmount Decimal  @default(0.0) @db.Decimal(10,2)
  totalAmount         Decimal  @db.Decimal(10,2)
  offerCode           String?
  notes               String?
  servedAt            DateTime?
  collectedAt         DateTime?
  orderItems          OrderItem[]
  payments            Payment[]
  refunds             Refund[]
  reviews             Review[]
  invoices            Invoice[]
  customer            Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId          String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([orderType, createdAt])
  @@index([assignedServiceStaffId, status])
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  quantity       Int
  price          Decimal  @db.Decimal(10,2)
  notes          String?
  customizations Json?
  createdAt      DateTime @default(now())
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10,2)
  method        PaymentMethod
  transactionId String?
  paymentId     String?
  signature     String?
  status        PaymentStatus @default(PENDING)
  cashRegisterSessionId String?
  cashRegisterSession   CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id], onDelete: SetNull)
  refunds       Refund[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Offer {
  id             String       @id @default(uuid())
  code           String       @unique
  title          String?
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Decimal      @db.Decimal(10,2)
  minOrderAmount Decimal      @default(0.0) @db.Decimal(10,2)
  expiryDate     DateTime
  usageLimit     Int?
  usageCount     Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Review {
  id           String    @id @default(uuid())
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  menuItemId   String?
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  customerName String
  rating       Int
  comment      String?
  images       String[]
  adminReply   String?
  createdAt    DateTime  @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model Invoice {
  id             String   @id @default(uuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber  String   @unique
  pdfUrl         String?
  amount         Decimal  @db.Decimal(10,2)
  taxAmount      Decimal  @db.Decimal(10,2)
  discountAmount Decimal  @db.Decimal(10,2)
  createdAt      DateTime @default(now())
}

model Customer {
  id         String   @id @default(uuid())
  name       String?
  phone      String?  @unique
  email      String?
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Reservation {
  id             String            @id @default(uuid())
  customerName   String
  customerPhone  String
  guestCount     Int
  startsAt       DateTime
  endsAt         DateTime?
  status         ReservationStatus @default(PENDING)
  notes          String?
  tableId        String?
  table          Table?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([startsAt, status])
  @@index([tableId, startsAt])
}

model IngredientCategory {
  id          String       @id @default(uuid())
  name        String       @unique
  ingredients Ingredient[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Ingredient {
  id               String             @id @default(uuid())
  name             String             @unique
  unit             String
  quantityOnHand   Decimal            @default(0) @db.Decimal(12,3)
  minimumQuantity  Decimal            @default(0) @db.Decimal(12,3)
  unitCost         Decimal            @default(0) @db.Decimal(10,2)
  expiresAt        DateTime?
  categoryId       String?
  category         IngredientCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipeItems      RecipeIngredient[]
  stockMovements   StockMovement[]
  purchaseItems    PurchaseOrderItem[]
  receiptItems     PurchaseReceiptItem[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([quantityOnHand, minimumQuantity])
}

model RecipeIngredient {
  id           String     @id @default(uuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Decimal    @db.Decimal(12,3)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([menuItemId, ingredientId])
}

model StockMovement {
  id             String            @id @default(uuid())
  ingredientId   String
  ingredient     Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12,3)
  unitCost       Decimal?          @db.Decimal(10,2)
  reason         String?
  referenceType  String?
  referenceId    String?
  idempotencyKey String?           @unique
  actorId        String?
  createdAt      DateTime          @default(now())

  @@index([ingredientId, createdAt])
  @@index([referenceType, referenceId])
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  notes          String?
  isActive       Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([name, phone])
}

model PurchaseOrder {
  id               String               @id @default(uuid())
  purchaseNumber   String               @unique
  supplierId       String
  supplier         Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status           PurchaseStatus       @default(DRAFT)
  totalAmount      Decimal              @default(0) @db.Decimal(10,2)
  notes            String?
  items            PurchaseOrderItem[]
  receipts         PurchaseReceipt[]
  supplierPayments SupplierPayment[]
  createdById      String?
  approvedById     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, createdAt])
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId     String
  ingredient       Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  receiptItems     PurchaseReceiptItem[]
  orderedQuantity  Decimal       @db.Decimal(12,3)
  receivedQuantity Decimal       @default(0) @db.Decimal(12,3)
  unitCost         Decimal       @db.Decimal(10,2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([purchaseOrderId, ingredientId])
}

model PurchaseReceipt {
  id                    String               @id @default(uuid())
  purchaseOrderId       String
  purchaseOrder         PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  idempotencyKey        String               @unique
  supplierInvoiceNumber String?
  notes                 String?
  items                 PurchaseReceiptItem[]
  receivedById          String?
  receivedAt            DateTime             @default(now())
}

model PurchaseReceiptItem {
  id                  String            @id @default(uuid())
  receiptId           String
  receipt             PurchaseReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  ingredientId        String
  ingredient          Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity            Decimal           @db.Decimal(12,3)
  unitCost            Decimal           @db.Decimal(10,2)

  @@unique([receiptId, purchaseOrderItemId])
}

model Expense {
  id          String          @id @default(uuid())
  description String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10,2)
  incurredAt  DateTime        @default(now())
  reference   String?
  notes       String?
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([incurredAt, category])
}

model SupplierPayment {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  amount          Decimal       @db.Decimal(10,2)
  method          PaymentMethod
  reference       String?
  paidAt          DateTime      @default(now())
  recordedById    String?
  createdAt       DateTime      @default(now())

  @@index([paidAt])
}

model Refund {
  id                 String       @id @default(uuid())
  orderId            String
  order              Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId          String?
  payment            Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  providerRefundId   String?      @unique
  amount             Decimal      @db.Decimal(10,2)
  method             PaymentMethod
  status             RefundStatus @default(PENDING)
  reason             String?
  requestedById      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model CashRegisterSession {
  id              String    @id @default(uuid())
  cashierId       String
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  openingBalance  Decimal   @db.Decimal(10,2)
  closingBalance  Decimal?  @db.Decimal(10,2)
  expectedBalance Decimal?  @db.Decimal(10,2)
  notes           String?
  payments        Payment[]

  @@index([cashierId, openedAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
