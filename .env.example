# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (from Project Settings → Database → URI)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:5432/postgres"

# ─── Supabase Auth & Storage ───────────────────────────────────────────────────
# From Supabase Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-supabase-anon-key>"
# Use the server-only service_role key (legacy) or a Supabase secret key.
# Never use the publishable/anon key here or expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY="<your-supabase-service-role-key>"

# ─── Payments (Razorpay) ───────────────────────────────────────────────────────
# From Razorpay Dashboard → Settings → API Keys
# Use test keys (rzp_test_*) for development, live keys for production
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="<your-razorpay-key-secret>"
# Same as RAZORPAY_KEY_ID — exposed to the browser for the Razorpay checkout SDK
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxxxx"

# Optional — Razorpay webhook secret for server-side event verification
# From Razorpay Dashboard → Settings → Webhooks → Secret
# RAZORPAY_WEBHOOK_SECRET="<your-razorpay-webhook-secret>"

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Optional — required only for sending order receipt emails
# From https://resend.com/api-keys
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# RESEND_FROM_EMAIL="receipts@yourdomain.com"

# ─── Application ──────────────────────────────────────────────────────────────
# The public URL of your deployed app — used for QR code generation and auth
# redirect URLs. Must be set in production.
# Development: http://localhost:3000
# Production:  https://yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Table URL Security ──────────────────────────────────────────────────────
# Secret key used to sign table QR code URLs (HMAC-SHA256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 16 characters. Changing this invalidates all existing QR codes.
TABLE_TOKEN_SECRET="<your-secret-at-least-16-chars>"
